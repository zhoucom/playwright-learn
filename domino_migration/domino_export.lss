' ********************************************************************************
' Domino Data Export - Ultra-Fast Single-Pass (Data Preservation Mode)
' ********************************************************************************

Option Public
Option Explicit

' --- CONFIGURATION ---
Const EXPORT_ALL_DATA = True    ' False for testing (SAMPLE_LIMIT), True for full export
Const SAMPLE_LIMIT = 100        ' Max docs per form in test mode
Const SKIP_ATTACHMENTS = True   ' Set to True to skip attachment extraction for speed
Const EXPORT_BASE_DIR = "C:\temp\domino_export\"
' ********************************************************************************

' Global Schema Storage: List of Strings (Form -> "Field1,Field2,Field3")
Dim g_Schemas List As String 
' File Handle Storage: List of Integers (Form -> FileNumber)
Dim g_FileHandles List As Integer
' Document Counters (Form -> Count)
Dim g_DocCounters List As Long

Sub Initialize
    Dim session As New NotesSession
    Dim db As NotesDatabase
    Dim dc As NotesDocumentCollection
    Dim doc As NotesDocument
    Dim nextDoc As NotesDocument
    Dim processed As Long
    
    Set db = session.CurrentDatabase
    
    ' Ensure base dirs 
    On Error Resume Next
    Mkdir "C:\temp"
    Mkdir EXPORT_BASE_DIR
    If Not SKIP_ATTACHMENTS Then Mkdir EXPORT_BASE_DIR & "Attachments"
    On Error Goto 0
    
    ' 1. Pre-load Headers from Design (Seconds)
    Print "Pre-loading Form Design Headers..."
    Call LoadDesignSchemas(db)
    
    ' 2. Single Pass Export (Fastest)
    Print "Starting Single-Pass Export..."
    
    ' CRITICAL: Get document collection ONCE to avoid re-indexing slowness
    Set dc = db.AllDocuments
    Set doc = dc.GetFirstDocument
    processed = 0
    
    While Not (doc Is Nothing)
        ' Get next document BEFORE processing current (best practice for large collections)
        ' Note: In very large DBs, using dc.GetNextDocument(doc) is safer than 
        ' relying on the collection object repeatedly inside the loop.
        Set nextDoc = dc.GetNextDocument(doc)
        
        Call ProcessDocument(doc)
        
        processed = processed + 1
        If processed Mod 500 = 0 Then Print "Export Progress: " & processed & " docs..."
        
        ' Manual Recycle (LotusScript Garbage Collection support)
        Set doc = Nothing
        Set doc = nextDoc
    Wend
    
    ' Cleanup
    Call CloseAllFiles()
    
    Msgbox "Export Finished! Total docs: " & processed & Chr(10) & "Location: " & EXPORT_BASE_DIR
End Sub

' ********************************************************************************
' Load schemas from Design Forms
' ********************************************************************************
Sub LoadDesignSchemas(db As NotesDatabase)
    Dim fName As String
    Dim s As String
    Forall formObj In db.Forms
        fName = formObj.Name
        ' Build initial header from design fields
        s = "UNID|Created|Attachments|Form"
        Forall fieldname In formObj.Fields
            If Instr(1, "|" & s & "|", "|" & fieldname & "|", 5) = 0 Then
                s = s & "|" & fieldname
            End If
        End Forall
        s = s & "|__ExtraFields" ' The Overflow Column
        g_Schemas(fName) = s
    End Forall
End Sub

' ********************************************************************************
' Core Document Processor
' ********************************************************************************
Sub ProcessDocument(doc As NotesDocument)
    Dim formName As String
    Dim schemaStr As String
    Dim fileNum As Integer
    
    formName = doc.GetItemValue("Form")(0)
    If formName = "" Then formName = "UnknownForm"
    
    ' Respect sample limit if needed
    If Not EXPORT_ALL_DATA Then
        If Not IsElement(g_DocCounters(formName)) Then g_DocCounters(formName) = 0
        If g_DocCounters(formName) >= SAMPLE_LIMIT Then Exit Sub
    End If
    
    ' Lazy File Opening
    If Not IsElement(g_FileHandles(formName)) Then
        ' If we didn't find the form in design (Orphaned scenario)
        If Not IsElement(g_Schemas(formName)) Then
            schemaStr = "UNID|Created|Attachments|Form"
            Call UpdateSchemaFromDoc(doc, schemaStr)
            schemaStr = schemaStr & "|__ExtraFields"
            g_Schemas(formName) = schemaStr
        End If
        Call CreateCsvWithHeader(formName, g_Schemas(formName))
    End If
    
    fileNum = g_FileHandles(formName)
    schemaStr = g_Schemas(formName)
    
    ' Export the Row
    Call ExportRowToFile(fileNum, doc, schemaStr, formName)
    
    ' Increment Counter
    If Not IsElement(g_DocCounters(formName)) Then g_DocCounters(formName) = 0
    g_DocCounters(formName) = g_DocCounters(formName) + 1
End Sub

Sub UpdateSchemaFromDoc(doc As NotesDocument, schemaStr As String)
    Dim items As Variant
    Dim i As Integer
    items = doc.Items
    If IsArray(items) Then
        For i = 0 To Ubound(items)
            If Not (items(i) Is Nothing) Then
                If Instr(1, "|" & schemaStr & "|", "|" & items(i).Name & "|", 5) = 0 Then
                    schemaStr = schemaStr & "|" & items(i).Name
                End If
            End If
        Next
    End If
End Sub

Sub CreateCsvWithHeader(form As String, schemaStr As String)
    Dim fileNum As Integer
    Dim csvPath As String
    Dim safeForm As String
    
    ' Sanitize filename
    safeForm = R5Substitute(form, "/", "_")
    safeForm = R5Substitute(safeForm, "\", "_")
    
    csvPath = EXPORT_BASE_DIR & "data_" & safeForm & ".csv"
    fileNum = FreeFile
    Open csvPath For Output As #fileNum
    
    Dim headers As Variant
    Dim csvLine As String
    Dim i As Integer
    headers = Explode(schemaStr, "|")
    csvLine = ""
    For i = 0 To Ubound(headers)
        If i > 0 Then csvLine = csvLine & ","
        csvLine = csvLine & EncloseQuotes(Cstr(headers(i)))
    Next
    Print #fileNum, csvLine
    g_FileHandles(form) = fileNum
End Sub

Sub ExportRowToFile(fileNum As Integer, doc As NotesDocument, schemaStr As String, form As String)
    Dim fields As Variant
    Dim csvLine As String
    Dim i As Integer
    Dim fName As String
    Dim valStr As String
    Dim item As NotesItem
    Dim extraData As String
    Dim checkedFields List As Integer
    
    fields = Explode(schemaStr, "|")
    csvLine = ""
    extraData = ""
    
    ' 1. Export Standard Fields
    For i = 0 To Ubound(fields)
        fName = Cstr(fields(i))
        checkedFields(fName) = 1
        valStr = ""
        
        If fName = "UNID" Then
            valStr = doc.UniversalID
        Elseif fName = "Created" Then
            valStr = Cstr(doc.Created)
        Elseif fName = "Attachments" Then
            valStr = HandleAttachments(doc, form)
        Elseif fName = "Form" Then
            valStr = form
        Elseif fName = "__ExtraFields" Then
            ' Handled after the loop
            valStr = "[PENDING]"
        Else
            Set item = doc.GetFirstItem(fName)
            If Not (item Is Nothing) Then
                valStr = GetItemValueStr(doc, item)
            End If
        End If
        
        If i > 0 Then csvLine = csvLine & ","
        csvLine = csvLine & EncloseQuotes(valStr)
    Next
    
    ' 2. Capture Overflow (Extra Fields not in Header)
    Dim allItems As Variant
    allItems = doc.Items
    If IsArray(allItems) Then
        For i = 0 To Ubound(allItems)
            If Not (allItems(i) Is Nothing) Then
                If Not IsElement(checkedFields(allItems(i).Name)) Then
                    extraData = extraData & allItems(i).Name & ": " & GetItemValueStr(doc, allItems(i)) & "; "
                End If
            End If
        Next
    End If
    
    ' Finalize row by replacing [PENDING] with actual extraData
    csvLine = R5Substitute(csvLine, EncloseQuotes("[PENDING]"), EncloseQuotes(extraData))
    
    Print #fileNum, csvLine
End Sub

Sub CloseAllFiles()
    Forall h In g_FileHandles
        Close #h
    End Forall
    Erase g_FileHandles
End Sub

Function GetItemValueStr(doc As NotesDocument, item As NotesItem) As String
    Dim valStr As String
    If item.Type = 1 Then ' RICHTEXT
        On Error Resume Next
        valStr = doc.Abstract(2000, False, False, item.Name)
        If Err <> 0 Then valStr = "[Complex RTF]"
        On Error Goto 0
        valStr = "[RTF] " & R5CleanupText(valStr)
    Else
        Dim v As Variant
        v = item.Values
        If IsArray(v) Then
            valStr = R5Implode(v, "; ")
        Else
            valStr = Cstr(v)
        End If
        valStr = R5CleanupText(valStr)
    End If
    GetItemValueStr = valStr
End Function

Function HandleAttachments(doc As NotesDocument, form As String) As String
    Dim obj As NotesEmbeddedObject
    Dim path As String
    Dim outPaths As String
    Dim subDir As String
    Dim hasCreatedDir As Integer
    
    If SKIP_ATTACHMENTS Then
        HandleAttachments = "[Skipped]"
        Exit Function
    End If
    
    hasCreatedDir = False
    outPaths = ""
    subDir = EXPORT_BASE_DIR & "Attachments\" & form & "\" & doc.UniversalID & "\"
    
    If doc.HasEmbedded Then
        Dim embObjs As Variant
        embObjs = doc.EmbeddedObjects
        If Not IsEmpty(embObjs) Then
            Dim oIdx As Integer
            For oIdx = 0 To Ubound(embObjs)
                Set obj = embObjs(oIdx)
                If obj.Type = 1080 Then ' EMBED_ATTACHMENT
                    If Not hasCreatedDir Then
                        On Error Resume Next
                        Mkdir EXPORT_BASE_DIR & "Attachments\" & form
                        Mkdir subDir
                        On Error Goto 0
                        hasCreatedDir = True
                    End If
                    path = subDir & obj.Source
                    Call obj.ExtractFile(path)
                    outPaths = outPaths & obj.Source & "; "
                End If
            Next
        End If
    End If
    HandleAttachments = outPaths
End Function

Function EncloseQuotes(txt As String) As String
    Dim tmp As String
    tmp = txt
    tmp = R5Substitute(tmp, """", """""")
    EncloseQuotes = """" & tmp & """"
End Function

Function R5Substitute(sSource As String, sSearch As String, sReplace As String) As String
    Dim sResult As String
    Dim nPos As Long
    sResult = sSource
    nPos = Instr(sResult, sSearch)
    While nPos > 0
        sResult = Left(sResult, nPos - 1) & sReplace & Mid(sResult, nPos + Len(sSearch))
        nPos = Instr(nPos + Len(sReplace), sResult, sSearch)
    Wend
    R5Substitute = sResult
End Function

Function R5Implode(vArray As Variant, separator As String) As String
    Dim s As String
    Dim i As Long
    s = ""
    For i = Lbound(vArray) To Ubound(vArray)
        s = s & Cstr(vArray(i))
        If i < Ubound(vArray) Then s = s & separator
    Next
    R5Implode = s
End Function

Function R5CleanupText(txt As String) As String
    Dim s As String
    s = R5Substitute(txt, Chr(10), " ")
    s = R5Substitute(s, Chr(13), " ")
    R5CleanupText = R5Substitute(s, Chr(9), " ")
End Function

Function Explode(Byval s As String, separator As String) As Variant
    Dim result() As String
    Dim n As Integer
    Dim p As Long
    n = 0
    p = Instr(s, separator)
    While p > 0
        Redim Preserve result(n)
        result(n) = Left(s, p - 1)
        s = Mid(s, p + Len(separator))
        n = n + 1
        p = Instr(s, separator)
    Wend
    Redim Preserve result(n)
    result(n) = s
    Explode = result
End Function
