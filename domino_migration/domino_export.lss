' ********************************************************************************
' Domino Full Data Export Agent (Two-Pass for Perfect Schema)
' Target: Domino R5+ Compatibility
' Features: 
'  - Two-Pass: 1. Scan for Schema (Union of Fields), 2. Export Data
'  - Guarantees 100% Header Accuracy & Column Alignment
'  - Handles RichText & Attachments
' ********************************************************************************

Option Public
Option Explicit

' --- CONFIGURATION ---
Const EXPORT_ALL_DATA = True    ' False to limit to SAMPLE_LIMIT docs per form 
Const SAMPLE_LIMIT = 10         ' Number of docs to scan AND export in test mode
Const FULL_MODE_SCAN_LIMIT = 50 ' Only used when EXPORT_ALL_DATA=True (0 for perfect accuracy)
Const SKIP_ATTACHMENTS = True   ' Set to True to skip attachment extraction for speed
Const EXPORT_BASE_DIR = "C:\temp\domino_export\"
' ********************************************************************************

' Global Schema Storage: List of Strings (Form -> "Field1,Field2,Field3")
Dim g_Schemas List As String 

Sub Initialize
    Dim session As New NotesSession
    Dim db As NotesDatabase
    Dim processedForms List As Integer
    Dim orphanQuery As String
    Dim formCount As Integer
    
    Set db = session.CurrentDatabase
    
    ' Ensure base dirs (idempotent)
    On Error Resume Next
    Mkdir "C:\temp"
    Mkdir EXPORT_BASE_DIR
    If Not SKIP_ATTACHMENTS Then Mkdir EXPORT_BASE_DIR & "Attachments"
    On Error Goto 0
    
    Print "PHASE 1: Exporting Known Forms..."
    
    orphanQuery = ""
    formCount = 0
    ' Iterate through all forms in the database
    Forall formObj In db.Forms
        Dim fName As String
        fName = formObj.Name
        If fName <> "" Then
            processedForms(fName) = 1
            Call ProcessForm(db, fName)
            
            ' Build orphan query carefully (Domino query length limit is approx 512-1024 chars in Search)
            If Len(orphanQuery) < 800 Then 
                If orphanQuery <> "" Then orphanQuery = orphanQuery & " & "
                orphanQuery = orphanQuery & "Form != """ & fName & """"
            End If
            formCount = formCount + 1
        End If
    End Forall
    
    Print "PHASE 2: Checking for Orphaned Data..."
    ' If the database has documents with NO Form field, orphanQuery will catch them too
    If orphanQuery = "" Then orphanQuery = "@All" ' Should not happen if forms exist
    
    Call ProcessOrphanedDocs(db, orphanQuery)
    
    Msgbox "Export Finished! Checked " & formCount & " forms." & Chr(10) & "Location: " & EXPORT_BASE_DIR
End Sub

' ********************************************************************************
' Optimized Form-by-Form Processor
' ********************************************************************************
Sub ProcessForm(db As NotesDatabase, formName As String)
    Dim dc As NotesDocumentCollection
    Dim doc As NotesDocument
    Dim query As String
    Dim schemaStr As String
    Dim fileNum As Integer
    Dim csvPath As String
    Dim count As Long
    
    ' 1. BUILD SCHEMA 
    Dim scanLimit As Integer
    If EXPORT_ALL_DATA Then
        scanLimit = FULL_MODE_SCAN_LIMIT
    Else
        scanLimit = SAMPLE_LIMIT
    End If
    
    ' Use @LowerCase for query to handle case-mismatch in R5/R6
    query = "@LowerCase(Form) = """ & Lcase(formName) & """"
    Set dc = db.Search(query, Nothing, scanLimit) 
    
    ' Fallback to simple query if complex one returns 0 (LotusScript quirks)
    If dc.Count = 0 Then
        query = "Form = """ & formName & """"
        Set dc = db.Search(query, Nothing, scanLimit)
    End If
    
    If dc.Count = 0 Then Exit Sub 
    
    Print "Processing Form: " & formName & " (Scanning Schema...)"
    schemaStr = "UNID|Created|Attachments"
    Set doc = dc.GetFirstDocument
    While Not (doc Is Nothing)
        Call UpdateSchema(doc, schemaStr)
        Set doc = dc.GetNextDocument(doc)
    Wend
    g_Schemas(formName) = schemaStr
    
    ' 2. PREPARE CSV & WRITE HEADER
    csvPath = EXPORT_BASE_DIR & "data_" & formName & ".csv"
    fileNum = FreeFile
    Open csvPath For Output As #fileNum
    Call WriteHeaderToFile(fileNum, schemaStr)
    
    ' 3. EXPORT DATA
    Print "Processing Form: " & formName & " (Exporting Data...)"
    ' Re-execute search without document limit if EXPORT_ALL_DATA
    If EXPORT_ALL_DATA Then
        Set dc = db.Search(query, Nothing, 0)
    Else
        ' In sample mode, we already have the collection from Build Schema step
    End If
    
    count = 0
    Set doc = dc.GetFirstDocument
    While Not (doc Is Nothing)
        Call ExportRowToFile(fileNum, doc, schemaStr, formName)
        count = count + 1
        If count Mod 100 = 0 Then Print "  Form '" & formName & "': " & count & " docs..."
        Set doc = dc.GetNextDocument(doc)
    Wend
    
    Close #fileNum
    Print "Finished Form: " & formName & " (" & count & " docs exported)"
End Sub

Sub ProcessOrphanedDocs(db As NotesDatabase, query As String)
    Dim dc As NotesDocumentCollection
    Dim doc As NotesDocument
    Dim schemaStr As String
    Dim fileNum As Integer
    Dim csvPath As String
    Dim count As Long
    
    ' 1. BUILD SCHEMA (Use a separate scan of first few docs)
    Dim scanLimit As Integer
    If EXPORT_ALL_DATA Then
        scanLimit = FULL_MODE_SCAN_LIMIT
        If scanLimit = 0 Then scanLimit = 50 
    Else
        scanLimit = SAMPLE_LIMIT
    End If
    
    ' We use Search with 0 to get the full collection, then manually limit scan
    Set dc = db.Search(query, Nothing, 0) 
    If dc.Count = 0 Then Exit Sub
    
    Print "Processing Orphaned Docs (Scanning Schema...)"
    schemaStr = "UNID|Created|Attachments"
    Set doc = dc.GetFirstDocument
    count = 0
    While Not (doc Is Nothing) And (count < scanLimit)
        Call UpdateSchema(doc, schemaStr)
        Set doc = dc.GetNextDocument(doc)
        count = count + 1
    Wend
    
    csvPath = EXPORT_BASE_DIR & "data_OrphanedDocs.csv"
    fileNum = FreeFile
    Open csvPath For Output As #fileNum
    Call WriteHeaderToFile(fileNum, schemaStr)
    
    Print "Processing Orphaned Docs (Exporting Data...)"
    count = 0
    Set doc = dc.GetFirstDocument
    Do While Not (doc Is Nothing)
        Call ExportRowToFile(fileNum, doc, schemaStr, "Orphaned")
        count = count + 1
        If count Mod 100 = 0 Then Print "  Orphaned: " & count & " docs..."
        Set doc = dc.GetNextDocument(doc)
        
        ' Respect SAMPLE_LIMIT even for orphaned docs if test mode
        If Not EXPORT_ALL_DATA Then
            If count >= SAMPLE_LIMIT Then Exit Do
        End If
    Loop
    
    Close #fileNum
    Print "Finished Orphaned Docs (" & count & " docs exported)"
End Sub

Sub UpdateSchema(doc As NotesDocument, schemaStr As String)
    Dim items As Variant
    Dim i As Integer
    Dim iName As String
    items = doc.Items
    If IsArray(items) Then
        For i = 0 To Ubound(items)
            If Not (items(i) Is Nothing) Then
                iName = items(i).Name
                If Instr(1, "|" & schemaStr & "|", "|" & iName & "|", 5) = 0 Then
                    schemaStr = schemaStr & "|" & iName
                End If
            End If
        Next
    End If
End Sub

Sub WriteHeaderToFile(fileNum As Integer, schemaStr As String)
    Dim headers As Variant
    Dim csvLine As String
    Dim i As Integer
    headers = Explode(schemaStr, "|")
    csvLine = ""
    For i = 0 To Ubound(headers)
        If i > 0 Then csvLine = csvLine & ","
        csvLine = csvLine & EncloseQuotes(Cstr(headers(i)))
    Next
    Print #fileNum, csvLine
End Sub

Sub ExportRowToFile(fileNum As Integer, doc As NotesDocument, schemaStr As String, form As String)
    Dim fields As Variant
    Dim csvLine As String
    Dim i As Integer
    Dim fName As String
    Dim valStr As String
    Dim item As NotesItem
    
    fields = Explode(schemaStr, "|")
    csvLine = ""
    For i = 0 To Ubound(fields)
        fName = Cstr(fields(i))
        valStr = ""
        If fName = "UNID" Then
            valStr = doc.UniversalID
        Elseif fName = "Created" Then
            valStr = Cstr(doc.Created)
        Elseif fName = "Attachments" Then
            valStr = HandleAttachments(doc, form)
        Else
            Set item = doc.GetFirstItem(fName)
            If Not (item Is Nothing) Then
                valStr = GetItemValueStr(doc, item)
            End If
        End If
        If i > 0 Then csvLine = csvLine & ","
        csvLine = csvLine & EncloseQuotes(valStr)
    Next
    Print #fileNum, csvLine
End Sub



Function GetItemValueStr(doc As NotesDocument, item As NotesItem) As String
    Dim valStr As String
    
    If item.Type = RICHTEXT Then
        On Error Resume Next
        valStr = doc.Abstract(2000, False, False, item.Name)
        If Err <> 0 Then valStr = "[Complex RTF]"
        On Error Goto 0
        valStr = "[RTF] " & R5CleanupText(valStr)
    Else
        Dim v As Variant
        v = item.Values
        If IsArray(v) Then
            valStr = R5Implode(v, "; ")
        Else
            valStr = Cstr(v)
        End If
        valStr = R5CleanupText(valStr)
    End If
    
    GetItemValueStr = valStr
End Function


' --------------------------------------------------------------------------------
' HELPER FUNCTIONS
' --------------------------------------------------------------------------------

Function HandleAttachments(doc As NotesDocument, form As String) As String
    Dim obj As NotesEmbeddedObject
    Dim path As String
    Dim outPaths As String
    Dim subDir As String
    
    Dim hasCreatedDir As Integer
    hasCreatedDir = False
    
    outPaths = ""
    
    If SKIP_ATTACHMENTS Then
        HandleAttachments = "[Skipped Attachments]"
        Exit Function
    End If
    
    subDir = EXPORT_BASE_DIR & "Attachments\" & form & "\" & doc.UniversalID & "\"
    
    ' Lazy creation: Removed early Mkdir calls
    
    ' Check for all attachments (V2 and RichText embedded)
    If doc.HasEmbedded Then
        Dim embObjs As Variant
        embObjs = doc.EmbeddedObjects
        Dim oIdx As Integer
        For oIdx = 0 To Ubound(embObjs)
            Set obj = embObjs(oIdx)
            If obj.Type = EMBED_ATTACHMENT Then
                If Not hasCreatedDir Then
                    On Error Resume Next
                    Mkdir EXPORT_BASE_DIR & "Attachments\" & form
                    Mkdir subDir
                    On Error Goto 0
                    hasCreatedDir = True
                End If
            
                path = subDir & obj.Source
                Call obj.ExtractFile(path)
                outPaths = outPaths & obj.Source & " (" & path & "); "
            End If
        Next
    End If
    
    ' RichText specific check
    Dim docItems As Variant
    If IsArray(doc.Items) Then
        docItems = doc.Items
        Dim itmIdx As Integer
        For itmIdx = 0 To Ubound(docItems)
            Dim currentItm As NotesItem
            If Not (docItems(itmIdx) Is Nothing) Then
                Set currentItm = docItems(itmIdx)
                If currentItm.Type = RICHTEXT Then
                    Dim rt As Variant
                    Set rt = currentItm
                    Dim rtObjs As Variant
                    rtObjs = rt.EmbeddedObjects
                    If Not IsEmpty(rtObjs) Then
                        Dim objIdx As Integer
                        For objIdx = 0 To Ubound(rtObjs)
                            Set obj = rtObjs(objIdx)
                            If obj.Type = EMBED_ATTACHMENT Then
                                If Not hasCreatedDir Then
                                    On Error Resume Next
                                    Mkdir EXPORT_BASE_DIR & "Attachments\" & form
                                    Mkdir subDir
                                    On Error Goto 0
                                    hasCreatedDir = True
                                End If
                            
                                path = subDir & obj.Source
                                Call obj.ExtractFile(path)
                                outPaths = outPaths & obj.Source & " (" & path & "); "
                            End If
                        Next
                    End If
                End If
            End If
        Next
    End If
    
    HandleAttachments = outPaths
End Function

Function EncloseQuotes(txt As String) As String
    Dim tmp As String
    tmp = txt
    ' Double up internal quotes
    tmp = R5Substitute(tmp, """", """""")
    ' Wrap in quotes
    EncloseQuotes = """" & tmp & """"
End Function

Function R5Substitute(sSource As String, sSearch As String, sReplace As String) As String
    Dim sResult As String
    Dim nPos As Long
    sResult = sSource
    nPos = Instr(sResult, sSearch)
    While nPos > 0
        sResult = Left(sResult, nPos - 1) & sReplace & Mid(sResult, nPos + Len(sSearch))
        nPos = Instr(nPos + Len(sReplace), sResult, sSearch)
    Wend
    R5Substitute = sResult
End Function

Function R5Implode(vArray As Variant, separator As String) As String
    Dim s As String
    Dim i As Long
    s = ""
    For i = Lbound(vArray) To Ubound(vArray)
        s = s & Cstr(vArray(i))
        If i < Ubound(vArray) Then s = s & separator
    Next
    R5Implode = s
End Function

Function R5CleanupText(txt As String) As String
    Dim s As String
    s = R5Substitute(txt, Chr(10), " ")
    s = R5Substitute(s, Chr(13), " ")
    R5CleanupText = R5Substitute(s, Chr(9), " ")
End Function

Function Explode(Byval s As String, separator As String) As Variant
    ' Custom Split function for R5
    Dim result() As String
    Dim n As Integer
    Dim p As Long
    
    n = 0
    p = Instr(s, separator)
    While p > 0
        Redim Preserve result(n)
        result(n) = Left(s, p - 1)
        s = Mid(s, p + Len(separator))
        n = n + 1
        p = Instr(s, separator)
    Wend
    
    Redim Preserve result(n)
    result(n) = s
    
    Explode = result
End Function
